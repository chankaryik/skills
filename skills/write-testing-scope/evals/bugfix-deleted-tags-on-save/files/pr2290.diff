diff --git a/src/modules/automations/utilities/tags.js b/src/modules/automations/utilities/tags.js
new file mode 100644
index 0000000..5a9c3e2
--- /dev/null
+++ b/src/modules/automations/utilities/tags.js
@@ -0,0 +1,31 @@
+export function keepResolvedIds(ids = [], found = []) {
+  const existing = new Set(found.map((tag) => tag.id));
+  return ids.filter((id) => existing.has(id));
+}
+
+export function collectTagIds(steps = []) {
+  return steps
+    .filter((step) => step.type === 'add_tag' || step.type === 'remove_tag')
+    .flatMap((step) => step.tagIds ?? []);
+}
+
+export function keepResolvedTagIds(steps = [], found = []) {
+  return steps.map((step) =>
+    step.type === 'add_tag' || step.type === 'remove_tag'
+      ? { ...step, tagIds: keepResolvedIds(step.tagIds, found) }
+      : step,
+  );
+}
+
+// Publish shows the "No tags selected" warning when a tag step is empty. It
+// reads the savable ids, so a step whose tags were all deleted counts as empty.
+export function hasEmptyTagStep(steps = []) {
+  return steps.some(
+    (step) => (step.type === 'add_tag' || step.type === 'remove_tag') && !step.tagIds?.length,
+  );
+}
diff --git a/src/queries/tags.js b/src/queries/tags.js
index 91e0b44..c3f17a8 100644
--- a/src/queries/tags.js
+++ b/src/queries/tags.js
@@ -20,19 +20,38 @@ export function useTagsBulk(ids) {
   return useQuery({
     queryKey: computed(() => ['tags', 'bulk', toValue(ids)]),
-    queryFn: () => api.post('/tags/bulk', { ids: toValue(ids) }).then((r) => r.data),
+    queryFn: () => fetchBulk(toValue(ids)),
     enabled: computed(() => toValue(ids)?.length > 0),
-    meta: { errorToast: true },
   });
 }
+
+// When none of the requested ids exist, the API answers 404 "Tags do not
+// exist" instead of an empty list. Treat that as an empty list, with no
+// toast. Other errors still show the error toast.
+async function fetchBulk(ids) {
+  try {
+    const response = await api.post('/tags/bulk', { ids });
+    return response.data;
+  } catch (error) {
+    if (error?.response?.status === 404) return [];
+    notifyError(error);
+    throw error;
+  }
+}
+
+export function useTagsBulkAsync() {
+  const queryClient = useQueryClient();
+  return (ids, { force = false } = {}) =>
+    queryClient.fetchQuery({
+      queryKey: ['tags', 'bulk', ids],
+      queryFn: () => fetchBulk(ids),
+      staleTime: force ? 0 : 30_000,
+    });
+}
