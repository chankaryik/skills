@@ -0,0 +1,22 @@
+import { keepResolvedIds, keepResolvedTagIds } from '@/modules/automations/utilities/tags';
+
+describe('keepResolvedIds', () => {
+  it('drops ids the lookup did not return', () => {
+    expect(keepResolvedIds(['a', 'b', 'c'], [{ id: 'a' }, { id: 'c' }])).toEqual(['a', 'c']);
+  });
+});
+
+describe('keepResolvedTagIds', () => {
+  it('only touches tag steps', () => {
+    const steps = [
+      { type: 'add_tag', tagIds: ['a', 'b'] },
+      { type: 'send_message', text: 'hi' },
+    ];
+    expect(keepResolvedTagIds(steps, [{ id: 'b' }])).toEqual([
+      { type: 'add_tag', tagIds: ['b'] },
+      { type: 'send_message', text: 'hi' },
+    ]);
+  });
+});
