 import { computed, ref, watch } from 'vue';

+/**
+ * Shared paging state for list and table screens.
+ *
+ * Lists backed by an infinite query (`fetchNextPage` passed in) keep every
+ * loaded page in one cache. When the filters, the sort or the page size
+ * change, that cache is rebuilt from page 1, so the visible page has to go
+ * back to 1 as well, or it points at a page that no longer exists (APP-640).
+ * Plain paged lists keep their own behaviour.
+ */
 export function usePagedList({
   filters,
   sort,
   pageSize = ref(25),
   fetchNextPage,
   pages,
 }) {
   const currentPage = ref(1);

   const visibleRows = computed(() => {
     const page = pages.value?.[currentPage.value - 1];
     return page?.rows ?? [];
   });

@@ -18,18 +27,34 @@ export function usePagedList({
   async function goToPage(page) {
     if (fetchNextPage && page > (pages.value?.length ?? 0)) {
       await fetchNextPage();
     }
     currentPage.value = page;
   }

-  watch(
-    () => [filters.value, sort.value],
-    () => {
-      if (!fetchNextPage) {
-        currentPage.value = 1;
-      }
-    },
-    { deep: true },
-  );
+  // Plain paged lists already went back to page 1 on a filter or sort
+  // change. Lists with an infinite query rebuild their cache from page 1
+  // when the filters, sort or page size change, so they reset too now.
+  watch(
+    () => [filters.value, sort.value, pageSize.value],
+    (next, prev) => {
+      const changed = next.map(
+        (value, i) => JSON.stringify(value) !== JSON.stringify(prev[i]),
+      );
+      const [filtersChanged, sortChanged, pageSizeChanged] = changed;
+      if (!fetchNextPage) {
+        if (filtersChanged || sortChanged) currentPage.value = 1;
+        return;
+      }
+      if (filtersChanged || sortChanged || pageSizeChanged) {
+        currentPage.value = 1;
+      }
+    },
+    { deep: true },
+  );
 
   return {
     currentPage,
     visibleRows,
     goToPage,
   };
 }
