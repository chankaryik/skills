+
+    it('goes back to page 1 when the sort changes', async () => {
+      const { list, sort } = setupInfinite({ loadedPages: 2 });
+      await list.goToPage(2);
+      sort.value = { field: 'createdAt', direction: 'asc' };
+      await nextTick();
+      expect(list.currentPage.value).toBe(1);
+    });
+
+    it('goes back to page 1 when the page size changes', async () => {
+      const { list, pageSize } = setupInfinite({ loadedPages: 3 });
+      await list.goToPage(3);
